[submodule "docs"]
    path = docs
    url = https://github.com/bitshares/bitshares-core.wiki.git
    ignore = dirty
[submodule "libraries/fc"]
    path = libraries/fc
    # The only branch still pinned to the fork, and only for the post-quantum work:
    # fc/crypto/pqc.* , vendor/pqclean/ and fc::raw::pq_format do not exist upstream, so a
    # clone against bitshares/bitshares-fc cannot build this branch. Revert to the upstream
    # URL once the fc side is merged.
    #
    # The pinned commit is upstream master plus exactly those commits -- nothing else. The
    # OpenSSL 1.1+/3.x handling and the missing <cstdint> in string.hpp used to be carried
    # here too and are upstream now.
    url = https://github.com/pi314x/bitshares-fc.git
    branch = pq-hardfork-review
    ignore = dirty